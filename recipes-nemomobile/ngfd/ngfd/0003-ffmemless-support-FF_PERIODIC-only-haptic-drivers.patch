From: Florent Revest <revestflo@gmail.com>
Subject: [PATCH] ffmemless: support FF_PERIODIC-only haptic drivers

Upstream-Status: Pending

Modern Linux FF drivers like the Cirrus cs40l26 (used on smartwatches
such as the Pixel Watch 2) advertise only FF_PERIODIC + FF_SINE +
FF_GAIN -- no FF_CONSTANT, no FF_RUMBLE. ffmemless was written before
these chips existed; it filters them out at probe, has no
FF_PERIODIC default-fallback effect, and never fires single-shot
events for them in the first place. This patch makes it work:

1. evdev selection: accept any of FF_RUMBLE / FF_CONSTANT /
   FF_PERIODIC as a sufficient indication of a usable force-feedback
   device. EVIOCSFF still fails per-effect at upload time for effects
   the device doesn't support, so this is no less safe than before.

2. Default fall-back effect: add a third branch that uses FF_PERIODIC
   with an FF_SINE waveform when neither FF_CONSTANT nor FF_RUMBLE is
   available. Combined with (1) this lets ffmemless init successfully
   on cs40l26 and similar.

3. Single-shot events: the original code only fires the FF effect when
   sound.repeat=true or haptic.duration>0 (because then sink_prepare
   bumps copy->repeat to INT32_MAX). For non-repeating events with no
   haptic.duration the default copy->repeat=0 makes ffm_play() hit the
   STOP branch and never start. On sound-less haptic-only setups
   (smartwatches with no audio) this means press / notif_normal /
   notif_strong silently no-op. Fix: treat such events as single-shot
   and fire them exactly once.

4. Per-event duration: when haptic.duration is set, also drive the
   kernel-side ff_effect.replay.length from it. Drivers like cs40l26
   BUZZGEN play for exactly replay.length ms and then stop -- writing
   EV_FF with value=INT32_MAX does NOT extend the buzz; only changing
   replay.length does. This lets events.d define per-event durations
   that the user can actually feel.

5. events.d type coercion: parse haptic.duration via a uint-then-string
   fallback. ngfd's events.d loader stores every key as a string unless
   the key is pre-registered in ngfd.ini's [keytypes] as INTEGER, so
   n_proplist_get_uint() silently returns 0 for events.d values. Fall
   back to n_proplist_get_string() + strtoul.

6. Repeating events: sound.repeat (alarm, ringtone) means vibrate until
   the client stops the request. ffmemless played one iteration and
   completed its sink from the completion timer, which ends the request
   when there is no sound sink to keep it open. Re-trigger the effect
   from that timer instead until the request is stopped.

7. Arm the completion timer once the effect has started, not before it
   is uploaded: the upload wakes the DSP over I2C and that latency was
   cut off every buzz. It also kept the erase from landing while the
   chip was back in hibernation, where the stop write was NACKed and
   the next erases blocked waiting for a completion that never came.

8. Direction: effects defined in the ini get direction 0x4000 (forward)
   or 0xC000 (reverse). cs40l26 accepts 0x0000 and 0x8000 only and
   rejects anything else with "Invalid ff_effect direction", so no ini
   effect ever played there. Use 0x0000 and 0x8000, still 180 degrees
   apart; the ff-memless drivers ignore the direction anyway.

Signed-off-by: Florent Revest <revestflo@gmail.com>
---
 src/plugins/ffmemless/ffmemless.c |  6 +--
 src/plugins/ffmemless/ffmemless.h |  4 +-
 src/plugins/ffmemless/plugin.c    | 90 ++++++++++++++++++++++++-------
 3 files changed, 77 insertions(+), 23 deletions(-)

diff --git a/src/plugins/ffmemless/ffmemless.c b/src/plugins/ffmemless/ffmemless.c
index 0a5bef2..1c83052 100644
--- a/src/plugins/ffmemless/ffmemless.c
+++ b/src/plugins/ffmemless/ffmemless.c
@@ -109,9 +109,9 @@ int ffmemless_evdev_file_search(unsigned long features[4])
 			i++;
 			continue;
 		}
-		result = test_bit(FF_RUMBLE, features);
-		result = result || test_bit(FF_CONSTANT, features);
-		result = result && test_bit(FF_PERIODIC, features);
+		result = test_bit(FF_RUMBLE, features) ||
+			 test_bit(FF_CONSTANT, features) ||
+			 test_bit(FF_PERIODIC, features);
 		if (result)
 			return fp;
 
diff --git a/src/plugins/ffmemless/ffmemless.h b/src/plugins/ffmemless/ffmemless.h
index 3c09b45..9f85051 100644
--- a/src/plugins/ffmemless/ffmemless.h
+++ b/src/plugins/ffmemless/ffmemless.h
@@ -21,8 +21,8 @@
 #ifndef __FFMEMLESS_H
 #define __FFMEMLESS_H
 
-#define FF_DIR_FORWARD	0x4000
-#define FF_DIR_REVERSE	0xC000
+#define FF_DIR_FORWARD	0x0000
+#define FF_DIR_REVERSE	0x8000
 
 int ffmemless_play(int effect_id, int device_file, int play);
 int ffmemless_upload_effect(struct ff_effect *effect, int device_file);
diff --git a/src/plugins/ffmemless/plugin.c b/src/plugins/ffmemless/plugin.c
index 7131e78..19f24dd 100644
--- a/src/plugins/ffmemless/plugin.c
+++ b/src/plugins/ffmemless/plugin.c
@@ -61,6 +61,7 @@ struct ffm_effect_data {
 	NSinkInterface *iface;
 	int id;
 	int repeat;
+	gboolean repeat_until_stopped;
 	guint playback_time;
 	int poll_id;
 	int16_t customEffectId;
@@ -269,12 +270,25 @@ static int ffm_setup_default_effect(GHashTable *effects, int dev_fd)
 		ff.type = FF_CONSTANT;
 		ff.replay.length = NGF_DEFAULT_DURATION;
 		ff.u.constant.level = NGF_DEFAULT_LEVEL;
-	} else {
+	} else if (ffmemless_has_feature(FF_RUMBLE, ffm.features)) {
 		N_DEBUG (LOG_CAT "Using rumble default effect");
 		ff.type = FF_RUMBLE;
 		ff.replay.length = NGF_DEFAULT_DURATION;
 		ff.u.rumble.strong_magnitude = NGF_DEFAULT_RMAGNITUDE;
 		ff.u.rumble.weak_magnitude = NGF_DEFAULT_RMAGNITUDE;
+	} else {
+		N_DEBUG (LOG_CAT "Using periodic sine default effect");
+		ff.type = FF_PERIODIC;
+		ff.replay.length = NGF_DEFAULT_DURATION;
+		ff.u.periodic.waveform = FF_SINE;
+		ff.u.periodic.period = 50;
+		ff.u.periodic.magnitude = NGF_DEFAULT_RMAGNITUDE;
+		ff.u.periodic.offset = 0;
+		ff.u.periodic.phase = 0;
+		ff.u.periodic.envelope.attack_length = 0;
+		ff.u.periodic.envelope.attack_level = 0;
+		ff.u.periodic.envelope.fade_length = 0;
+		ff.u.periodic.envelope.fade_level = 0;
 	}
 	if (ffm.cache_effects) {
 		memcpy(&data->cached_effect, &ff, sizeof(ff));
@@ -550,10 +564,30 @@ ffm_eff_error1:
 	return -1;
 }
 
+static int ffm_effect_id(const struct ffm_effect_data *data)
+{
+	return ffm.cache_effects ? data->cached_effect.id : data->id;
+}
+
 gboolean ffm_playback_done(gpointer userdata)
 {
 	struct ffm_effect_data *data = (struct ffm_effect_data *) userdata;
 
+	if (data->repeat_until_stopped) {
+		/* sound.repeat: the request lasts until the client stops it.
+		 * Drivers that play an effect once per EV_FF write (cs40l26
+		 * and the other non ff-memless ones) have gone quiet by now,
+		 * and an ff-memless loop would only survive until the request
+		 * completed below. Trigger the next iteration here instead
+		 * and keep this timer running. */
+		N_DEBUG (LOG_CAT "Effect id %d iteration done, repeating",
+				data->id);
+		if (!ffmemless_play(ffm_effect_id(data), ffm.dev_file,
+				data->repeat))
+			return TRUE;
+		N_DEBUG (LOG_CAT "Effect id %d re-trigger failed", data->id);
+	}
+
 	N_DEBUG (LOG_CAT "Effect id %d completed", data->id);
 
 	if (ffm.cache_effects) {
@@ -568,13 +602,7 @@ static int ffm_play(struct ffm_effect_data *data, int play)
 {
 	data->poll_id = 0;
 
-	/* if there is playback time set, this is single shot effect */
 	if (play) {
-		if (data->playback_time) {
-			N_DEBUG (LOG_CAT "setting up completion timer");
-			data->poll_id = g_timeout_add(data->playback_time + 20,
-						ffm_playback_done, data);
-		}
 		N_DEBUG (LOG_CAT "Starting playback %d", data->id);
 	} else {
 		if (ffm.cache_effects) {
@@ -601,10 +629,6 @@ static int ffm_play(struct ffm_effect_data *data, int play)
 					data->cached_effect.u.periodic.custom_len = 0;
 				}
 				N_DEBUG (LOG_CAT "%d effect re-load failed", data->id);
-				if (data->poll_id) {
-					g_source_remove (data->poll_id);
-					data->poll_id = 0;
-				}
 				return FALSE;
 			}
 			// custom data in stack, needed only for upload
@@ -613,15 +637,23 @@ static int ffm_play(struct ffm_effect_data *data, int play)
 				data->cached_effect.u.periodic.custom_len = 0;
 			}
 		}
+	}
 
-		if (ffmemless_play(data->cached_effect.id, ffm.dev_file, play))
-			return FALSE;
-		return TRUE;
-	} else {
-		if (ffmemless_play(data->id, ffm.dev_file, play))
-			return FALSE;
-		return TRUE;
+	if (ffmemless_play(ffm_effect_id(data), ffm.dev_file, play))
+		return FALSE;
+
+	/* If there is playback time set, this is a single shot effect (or
+	 * one iteration of a repeating one): arm the completion timer only
+	 * now that the effect is running. The upload above is synchronous
+	 * and can take a while (cs40l26 wakes its DSP over I2C first), and
+	 * on such drivers erasing the effect from the timer also stops it,
+	 * so a timer armed earlier would cut the effect short. */
+	if (play && data->playback_time) {
+		N_DEBUG (LOG_CAT "setting up completion timer");
+		data->poll_id = g_timeout_add(data->playback_time + 20,
+					ffm_playback_done, data);
 	}
+	return TRUE;
 }
 
 static void ffm_sink_shutdown(NSinkInterface *iface)
@@ -706,6 +738,15 @@ static int ffm_sink_prepare(NSinkInterface *iface, NRequest *request)
 
 	repeat = n_proplist_get_bool (props, FFM_SOUND_REPEAT_KEY);
 	playback_time = n_proplist_get_uint (props, FFM_HAPTIC_DURATION_KEY);
+	if (!playback_time) {
+		/* Events.d stores unregistered keys as strings, so
+		 * n_proplist_get_uint() returns 0 for haptic.duration
+		 * read from events.d -- fall back to string parsing. */
+		const char *s = n_proplist_get_string (props,
+				FFM_HAPTIC_DURATION_KEY);
+		if (s)
+			playback_time = (guint) strtoul (s, NULL, 10);
+	}
 	if (repeat || playback_time) {
 		/*
 		 * If duration was not defined, it's zero and we don't report playback
@@ -713,11 +754,24 @@ static int ffm_sink_prepare(NSinkInterface *iface, NRequest *request)
 		 * keep repeating them until timer runs out and effect ends.
 		 */
 		copy->repeat = INT32_MAX; /* repeat to "infinity" */
+		copy->repeat_until_stopped = repeat;
 		if (!copy->playback_time && playback_time) {
 			copy->playback_time = playback_time;
 		};
+	} else {
+		/* No sound.repeat AND no haptic.duration: single-shot
+		 * haptic. Fire it once -- without this branch copy->repeat
+		 * stays 0 and ffm_play() takes the STOP path. */
+		copy->repeat = 1;
 	}
 
+	/* Drive the kernel-side effect length too, not just the cleanup
+	 * timer. cs40l26 (and other timed_output / BUZZGEN style drivers)
+	 * play replay.length ms and stop; looping the EV_FF write does
+	 * not extend a buzz. */
+	if (playback_time && playback_time <= G_MAXUINT16)
+		copy->cached_effect.replay.length = playback_time;
+
 	N_DEBUG (LOG_CAT "prep effect %s, repeat %d times, duration of %d ms",
 			key, copy->repeat, copy->playback_time);
 
-- 
2.47.3

