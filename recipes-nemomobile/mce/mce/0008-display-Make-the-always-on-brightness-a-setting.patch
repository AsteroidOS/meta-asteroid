@@ -287,6 +287,15 @@ static guint    fba_setting_als_enabled_id = 0;
 
 /** Filter brightness through ALS setting */
 static gboolean fba_setting_als_autobrightness = MCE_DEFAULT_DISPLAY_ALS_AUTOBRIGHTNESS;
