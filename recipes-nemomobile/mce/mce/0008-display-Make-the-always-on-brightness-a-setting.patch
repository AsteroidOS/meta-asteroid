@@ -434,6 +455,14 @@ fba_setting_quit(void)
     mce_setting_notifier_remove(fba_setting_als_autobrightness_id),
         fba_setting_als_autobrightness_id = 0;
 
+    mce_setting_notifier_remove(fba_setting_lpm_brightness_id),
+        fba_setting_lpm_brightness_id = 0;
+
+    if( fba_setting_lpm_brightness_seed_id ) {
