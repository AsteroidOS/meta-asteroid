@@ -1877,9 +1883,16 @@ static void mdy_datapipe_lpm_brightness_cb(gconstpointer data)
 
     mce_log(LL_DEBUG, "input: %d -> %d", prev, curr);
 
-    // Sometimes it happens that the brightness changes while the als is disabled(ambient_light_level = -1), this cause the 
-    // filter to return 100%, resulting in max brightness ambient mode.
-    if( (curr == prev) || (ambient_light_level < 0))
+    if( curr == prev )
+        goto EXIT;
+
+    // Sometimes it happens that the brightness changes while the als is
+    // disabled(ambient_light_level = -1), this cause the filter to return
+    // 100%, resulting in max brightness ambient mode. An explicit always-on
+    // setting is a level someone chose, so it passes: without this a watch
+    // whose als never reports keeps the initial level of 1, which is why
+    // some ports show an always-on face that cannot be read.
+    if( ambient_light_level < 0 && mdy_brightness_setting_lpm < 1 )
         goto EXIT;
 
     mdy_brightness_set_lpm_level(curr);
@@ -2204,8 +2217,16 @@ static void mdy_datapipe_execute_brightness(void)
 
     /* And through lpm brightness pipe; to update:
      * - mdy_brightness_level_display_lpm
+     *
+     * Where the user has set an always-on level, that is what goes in, so it
+     * holds in the branch where the als filter passes its input through.
      */
-    datapipe_exec_full(&lpm_brightness_pipe, GINT_TO_POINTER(brightness));
+    int brightness_lpm = brightness;
+
+    if( mdy_brightness_setting_lpm > 0 )
+        brightness_lpm = mdy_brightness_setting_lpm;
+
+    datapipe_exec_full(&lpm_brightness_pipe, GINT_TO_POINTER(brightness_lpm));
 }
 
