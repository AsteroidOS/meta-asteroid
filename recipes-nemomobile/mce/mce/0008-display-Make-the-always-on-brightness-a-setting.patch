     mce_setting_track_int(MCE_SETTING_DISPLAY_DIM_STATIC_BRIGHTNESS,
                           &mdy_brightness_dim_static,
                           MCE_DEFAULT_DISPLAY_DIM_STATIC_BRIGHTNESS,
@@ -11512,6 +11549,9 @@ static void mdy_setting_quit(void)
