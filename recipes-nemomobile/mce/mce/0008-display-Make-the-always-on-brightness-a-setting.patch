+            fba_setting_lpm_brightness_seed_id = 0;
+    }
+
     mce_setting_notifier_remove(fba_setting_filter_lid_with_als_id),
         fba_setting_filter_lid_with_als_id = 0;
 
@@ -1272,6 +1301,61 @@ EXIT:
     return GINT_TO_POINTER(brightness * curr_scale / 100);
 }
 
+/** Brightness percentage at the top of a loaded als profile
+ *
+ * Slots a profile does not fill stay at lux=INT_MAX and val=100 from
+ * fba_als_filter_reset_profiles(), so scanning for the largest level would
+ * answer 100 for every profile. The top is the last slot that still carries
+ * a lux limit of its own.
+ *
+ * @param self als filtering state
+ * @param prof profile to read
+ *
+ * @return the level of the profile's last step, or 0 if it has none
+ */
+static int
+fba_als_filter_profile_top(const fba_als_filter_t *self, int prof)
+{
+    int top = 0;
+
+    if( prof < 0 || prof >= FBA_PROFILE_COUNT )
+        goto EXIT;
+
+    for( int slot = 0; slot <= FBA_PROFILE_STEPS; ++slot ) {
+        if( self->lut[prof][slot].lux == INT_MAX )
+            break;
+        top = self->lut[prof][slot].val;
+    }
+
+EXIT:
+    return top;
+}
+
+/** Write the als profile top into the unset always-on brightness setting
+ *
+ * Runs from an idle callback rather than from the filter, because setting a
+ * value re-filters the brightness and a filter must not re-enter itself.
+ *
+ * @param aptr the level to store, as a pointer
+ *
+ * @return FALSE, to run once
+ */
+static gboolean
+fba_setting_lpm_brightness_seed_cb(gpointer aptr)
+{
+    int ceiling = GPOINTER_TO_INT(aptr);
+
+    fba_setting_lpm_brightness_seed_id = 0;
+
+    if( fba_setting_lpm_brightness < 1 && ceiling > 0 ) {
+        mce_log(LL_NOTICE, "%s: seeded with the als profile top %d",
+                MCE_SETTING_DISPLAY_BRIGHTNESS_LPM, ceiling);
+        mce_setting_set_int(MCE_SETTING_DISPLAY_BRIGHTNESS_LPM, ceiling);
+    }
+
+    return FALSE;
+}
+
 /** Ambient Light Sensor filter for LPM brightness
  *
  * @param data The un-processed brightness setting (1-100) stored in a pointer
@@ -1282,19 +1366,40 @@ fba_datapipe_lpm_brightness_filter(gpointer data)
 {
     int value = GPOINTER_TO_INT(data);
 
-    if( !fba_setting_als_autobrightness || fba_inputflt_output_lux < 0 )
-        goto EXIT;
-
     if( lut_lpm.profiles < 1 )
         goto EXIT;
 
     int max_prof = lut_lpm.profiles - 1;
 
-    int prof = mce_xlat_int(1,100, 0,max_prof, value);
+    int prof    = mce_xlat_int(1,100, 0,max_prof, value);
+    int ceiling = fba_als_filter_profile_top(&lut_lpm, prof);
+
+    /* While the setting is unset the profile top is stored once, so the
+     * setting starts at the level this watch already used. This is ahead of
+     * the als checks below, because a watch whose sensor never reports needs
+     * the same starting value. */
+    if( fba_setting_lpm_brightness < 1 ) {
+        if( ceiling > 0 && !fba_setting_lpm_brightness_seed_id ) {
+            fba_setting_lpm_brightness_seed_id =
+                g_idle_add(fba_setting_lpm_brightness_seed_cb,
+                           GINT_TO_POINTER(ceiling));
+        }
+        goto EXIT;
+    }
+
+    if( !fba_setting_als_autobrightness || fba_inputflt_output_lux < 0 )
+        goto EXIT;
+
     /* Note: Input value is ignored and output is
      *       determined only by the als config */
     value = fba_als_filter_run(&lut_lpm, prof, fba_inputflt_output_lux);
 
+    /* The setting is the ceiling. The profile keeps its shape, so a watch with
+     * a real sensor still dims its always-on face in the dark, and the top of
+     * the profile lands where the user put it. */
+    if( ceiling > 0 )
+        value = mce_xlat_int(1, ceiling, 1, fba_setting_lpm_brightness, value);
+
 EXIT:
     return GINT_TO_POINTER(value);
 }
